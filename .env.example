PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
# Default development database directory. Leave empty to use server/data.
GAKUZAI_DATA_DIR=
# Optional full SQLite file path. If set, this overrides GAKUZAI_DATA_DIR.
GAKUZAI_DB_PATH=
# Raise this if a larger class shares the same server.
API_RATE_LIMIT=2000
